# Crea un file .env con i seguenti valori (opzionale).
PORT=3000
HOST=127.0.0.1
# Se non impostata, viene generata una password in data/admin-password.txt
ADMIN_PASSWORD=CAMBIA-QUESTA-PASSWORD
# Di default il blocco è attivo: si vedono solo le caselle fino a oggi (dicembre).
# Imposta 0 solo per le prove fuori stagione, così tutte le caselle restano visibili.
LOCK_BY_DATE=1
EVENT_YEAR=2026
